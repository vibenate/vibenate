{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vibenate",
  "version": "2.8.3",
  "description": "Discover web services and retrieve MCP, CLI and API connection guides for AI agents.",
  "author": {
    "name": "Vibenate",
    "url": "https://vibenate.com"
  },
  "homepage": "https://vibenate.com/connect",
  "repository": "https://github.com/vibenate/vibenate",
  "license": "MIT",
  "keywords": [
    "vibenate",
    "discovery",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Vibenate",
        "shortDescription": "Find service interfaces and contribute useful evidence",
        "developerName": "Vibenate",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://vibenate.com",
        "defaultPrompt": [
          "Find a service that fits my task and explain how to connect."
        ]
      }
    }
  }
}
