{
  "name": "@vibenate/client",
  "version": "2.8.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./native-worker": {
      "types": "./native-worker.d.mts",
      "import": "./native-worker.mjs"
    },
    "./assignment": {
      "types": "./assignment.d.mts",
      "import": "./assignment.mjs"
    },
    "./cli": {
      "types": "./cli.d.mts",
      "import": "./cli.mjs"
    }
  },
  "dependencies": {
    "jose": "^6.2.12",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "bin": {
    "vibenate": "./cli.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "types.d.mts",
    "cli.mjs",
    "cli.d.mts",
    "README.md",
    "local-mcp.mjs",
    "connection-guide.md",
    "package.json",
    "assignment.mjs",
    "assignment.d.mts",
    "native-worker.mjs",
    "native-worker.d.mts",
    "LICENSE",
    "plugins/vibenate/",
    "docs/",
    "llms.txt",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibenate/vibenate.git"
  },
  "description": "Vibenate JavaScript SDK for discovering web services and retrieving MCP, CLI, and API connection guides for AI agents.",
  "license": "MIT",
  "homepage": "https://vibenate.com",
  "keywords": [
    "vibenate",
    "ai-agents",
    "agent-tools",
    "service-discovery",
    "mcp",
    "model-context-protocol",
    "mcp-directory",
    "api-directory",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/vibenate/vibenate/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node scripts/verify-installed.mjs",
    "test:live": "node scripts/verify-installed.mjs --live",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3"
  }
}
